[Unit]
Description=Local llama.cpp inference server
After=local-fs.target
RequiresMountsFor=/var/lib/pi-local-rag

[Service]
Type=simple
User=rag
Group=rag
ExecStart=/usr/local/bin/llama-server --model /var/lib/pi-local-rag/models/llm/qwen2.5-3b-instruct-q4_k_m.gguf --alias qwen2.5-3b-instruct --host 127.0.0.1 --port 8080 --ctx-size 4096 --threads 4 --threads-batch 4 --batch-size 256 --ubatch-size 128 --parallel 1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/pi-local-rag/models

[Install]
WantedBy=multi-user.target
