[Unit]
Description=Local Qwen embedding server
After=local-fs.target
RequiresMountsFor=/var/lib/pi-local-rag

[Service]
Type=simple
User=rag
Group=rag
ExecStart=/usr/local/bin/llama-server --model /var/lib/pi-local-rag/models/embedding/Qwen3-Embedding-0.6B-Q8_0.gguf --alias qwen3-embedding-0.6b --host 127.0.0.1 --port 8081 --embedding --pooling last --ctx-size 2048 --threads 4 --threads-batch 4 --batch-size 256 --ubatch-size 128 --parallel 1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/pi-local-rag/models

[Install]
WantedBy=multi-user.target
